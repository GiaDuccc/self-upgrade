{
  "name": "self-upgrade-backend",
  "private": true,
  "version": "1.0.0",
  "author": "GiaDuc",
  "description": "Self Upgrade Personal Discipline Tracker Backend API (TypeScript + Node.js + MongoDB)",
  "engines": {
    "node": ">=18.x"
  },
  "scripts": {
    "clean": "rimraf build",
    "build": "tsc && tsc-alias",
    "production": "npm run build && cross-env BUILD_MODE=production node ./build/server.js",
    "dev": "cross-env BUILD_MODE=dev tsx watch ./src/server.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "async-exit-hook": "^2.0.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "http-status-codes": "^2.3.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.15.0",
    "resend": "^6.5.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.11.0",
    "rimraf": "^5.0.5",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.19.2",
    "typescript": "^5.4.5"
  }
}

